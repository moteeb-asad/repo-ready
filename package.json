{
  "name": "check-repo-ready",
  "version": "0.0.2",
  "description": "Check if your GitHub repo is ready to share: branch protection, CI on pull requests, secrets in git history, and a README with run steps.",
  "bin": {
    "repo-ready": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/cli.ts --format esm --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moteeb-asad/repo-ready.git"
  },
  "keywords": [
    "cli",
    "npx",
    "repo-health",
    "branch-protection",
    "github-rulesets",
    "github-actions",
    "secret-detection",
    "developer-tools",
    "ai-coding",
    "readme"
  ],
  "author": "Moteeb Asad (https://moteebasad.dev)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bugs": {
    "url": "https://github.com/moteeb-asad/repo-ready/issues"
  },
  "homepage": "https://github.com/moteeb-asad/repo-ready#readme",
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "commander": "^15.1.0",
    "execa": "^10.2.1",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
